# TRE UI Keycloak settings
TreKeyCloakSettings__Authority=${TRE_KEYCLOAK_URL}/realms/Dare-TRE/.well-known/openid-configuration
TreKeyCloakSettings__MetadataAddress=${TRE_KEYCLOAK_URL}/realms/Dare-TRE/.well-known/openid-configuration
TreKeyCloakSettings__BaseUrl=${TRE_KEYCLOAK_URL}/realms/Dare-TRE
TreKeyCloakSettings__ValidAudiences=Dare-TRE-API,Dare-TRE-UI
TreKeyCloakSettings__UseRedirectURL=false
TreKeyCloakSettings__Proxy=${useproxy}
TreKeyCloakSettings__ProxyAddresURL=${proxyurl}
TreKeyCloakSettings__BypassProxy="treAPI,seq-tre"
